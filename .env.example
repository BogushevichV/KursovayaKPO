# ============================================
# КОНФИГУРАЦИЯ БАЗЫ ДАННЫХ PostgreSQL
# ============================================

# Имя базы данных
DB_NAME=ExaminationReport

# Пользователь PostgreSQL
DB_USER=postgres

# Пароль пользователя PostgreSQL
DB_PASSWORD=your_password_here

# Хост базы данных
DB_HOST=127.0.0.1

# Порт PostgreSQL
DB_PORT=5432

# ============================================
# КОНФИГУРАЦИЯ СЕРВЕРА Flask
# ============================================

# Хост сервера
SERVER_HOST=0.0.0.0

# Порт сервера Flask
SERVER_PORT=5000

# Режим отладки (True/False)
DEBUG=True

# ============================================
# КОНФИГУРАЦИЯ ЛОГИРОВАНИЯ
# ============================================

# Директория для хранения логов
LOG_DIR=logs

# Префикс имен файлов логов
LOG_PREFIX=db_server